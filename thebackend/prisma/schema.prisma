generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ASSISTANT
}

enum MessageStatus {
  COMPLETED
  ERRORED
  CANCELLED
  STREAMING
}

// ─────────────────────────────────────
// COMMUNICATIONS
// A single chat session
// ─────────────────────────────────────

model Communication {
  id                String      @id @default(uuid())

  title             String?

  provider          String?
  model             String?

  startedAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  totalMessages     Int         @default(0)

  messages          Message[]
  inferenceLogs     InferenceLog[]

  @@index([startedAt])
  @@map("communications")
}

// ─────────────────────────────────────
// MESSAGES
// Every user/bot message
// ─────────────────────────────────────

model Message {
  id                String          @id @default(uuid())

  communicationId   String

  role              Role
  status            MessageStatus   @default(COMPLETED)

  content           String
  preview           String?

  sequenceNumber    Int

  provider          String?
  model             String?

  latencyMs         Int?

  promptTokens      Int?
  completionTokens  Int?
  totalTokens       Int?

  errorMessage      String?

  createdAt         DateTime        @default(now())

  metadata          Json?

  communication     Communication   @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
  @@index([createdAt])
  @@index([status])
  @@map("messages")
}

// ─────────────────────────────────────
// INFERENCE LOGS
// Raw inference metadata from SDK
// ─────────────────────────────────────

model InferenceLog {
  id                String      @id @default(uuid())

  communicationId   String?

  provider          String
  model             String

  status            MessageStatus

  latencyMs         Int?

  promptTokens      Int?
  completionTokens  Int?
  totalTokens       Int?

  inputPreview      String?
  outputPreview     String?

  errorMessage      String?

  startedAt         DateTime
  completedAt       DateTime?

  metadata          Json?

  createdAt         DateTime    @default(now())

  communication     Communication? @relation(fields: [communicationId], references: [id], onDelete: SetNull)

  events            ObservabilityEvent[]

  @@index([provider])
  @@index([model])
  @@index([status])
  @@index([startedAt])
  @@map("inference_logs")
}

// ─────────────────────────────────────
// OBSERVABILITY EVENTS
// Streaming + telemetry events
// ─────────────────────────────────────

model ObservabilityEvent {
  id                String      @id @default(uuid())

  inferenceLogId    String?

  type              String

  tokens            Int?
  throughputTps     Float?

  latencyMs         Int?

  payload           Json?

  createdAt         DateTime    @default(now())

  inferenceLog      InferenceLog? @relation(fields: [inferenceLogId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([createdAt])
  @@map("observability_events")
}

// ─────────────────────────────────────
// ANALYTICS SNAPSHOTS
// Cached dashboard metrics
// ─────────────────────────────────────

model AnalyticsSnapshot {
  id                    String      @id @default(uuid())

  provider              String?
  model                 String?

  totalRequests         Int         @default(0)

  successfulRequests    Int         @default(0)
  failedRequests        Int         @default(0)
  cancelledRequests     Int         @default(0)

  avgLatencyMs          Float?

  totalTokens           BigInt?

  throughputPerMinute   Float?

  snapshotStart         DateTime
  snapshotEnd           DateTime

  createdAt             DateTime    @default(now())

  @@index([snapshotStart, snapshotEnd])
  @@index([provider])
  @@index([model])
  @@map("analytics_snapshots")
}